# Copy this file to .env and fill in your values
# server.js loads .env automatically via dotenv

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# JWT secret — required in production
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Gemini API key (optional — planner/matcher fall back if unset)
# Never commit a real key. Put it only in .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Server port (default 3000)
PORT=3000

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=false

# Razorpay TEST keys (optional — mock checkout is used when these are empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
