# Copy this to .env — or export variables directly in your terminal
# Run: node -r dotenv/config server.js  (requires: npm install dotenv)
# Or:  GEMINI_API_KEY=... npm start

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# JWT secret — must be a long random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Google Gemini API key
# Get one free at: https://aistudio.google.com/app/apikey
# Default model: gemini-2.0-flash (fast + free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Override Gemini model (optional)
# Options: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Server port (default 3000)
PORT=3000
